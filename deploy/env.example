# /opt/vpserver-monitoring/.env  (dono do usuário do deploy, chmod 600) — NUNCA no repositório.
# Usado pelo deploy por pacote (scripts/server.py / GitHub Actions). Depois de mudar: python scripts/server.py restart
# (Quem instala pela imagem não usa este arquivo: o `vpmon init` gera o .env.)

# Login. Senha vazia = admin/admin com troca obrigatória no primeiro acesso.
# O `server.py setup` gera uma senha aleatória e liga a troca obrigatória.
VPMON_USER=admin
VPMON_PASSWORD=
VPMON_FORCE_PASSWORD_CHANGE=true

# Acesso pela internet (um dos dois):
#  - com domínio: token do túnel na Cloudflare (Networking -> Tunnels) + rota painel.seudominio -> http://vpserver-monitor:8080
#  - sem domínio: VPMON_TUNNEL_COMMAND=tunnel --no-autoupdate --url http://vpserver-monitor:8080  (endereço trycloudflare.com)
VPMON_TUNNEL_TOKEN=
VPMON_TUNNEL_COMMAND=

# Grupo docker do host (getent group docker) — o proxy precisa dele para abrir o socket.
DOCKER_GID=988

# Opcional: segredo que assina o cookie. Vazio = gerado e guardado em data/secret.
VPMON_SECRET=

# Nome no topo do painel (vazio = nome da instância na Oracle, ou o hostname).
VPMON_SERVER_NAME=

# Nomes bonitos para projetos do Compose ("meuapp=Meu App,api-x=API X"). Vazio = nome do projeto.
VPMON_APP_NAMES=

# A conta da Oracle é Always Free (yes), Pay As You Go (no) ou não sei (unknown)?
VPMON_ALWAYS_FREE=unknown

# Saída grátis por mês, em TB (Oracle: 10).
VPMON_EGRESS_TB=10

# WhatsApp das notificações (contêineres vpserver-whatsapp e vpserver-whatsapp-db, ~250 MB de RAM).
# O server.py setup gera as duas; a conexão (QR code) e o que avisar ficam na aba Notificações.
VPMON_WA_KEY=
VPMON_WA_DB_PASSWORD=

# IA (aba "IA") — DeepSeek. Também dá para pôr a chave pela tela (Configurações -> IA).
DEEPSEEK_API_KEY=
DEEPSEEK_API_HOST=api.deepseek.com
DEEPSEEK_API_ENDPOINT=/v1/chat/completions
DEEPSEEK_API_MODEL=deepseek-chat
